# ROUAA MVP — Environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Node / App ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rouaa
POSTGRES_PASSWORD=rouaa_dev
POSTGRES_DB=rouaa
DATABASE_URL=postgresql://rouaa:rouaa_dev@localhost:5432/rouaa

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Backend (NestJS) ---
BACKEND_PORT=4000
BACKEND_CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=1d

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:4000/api/v1

# --- Intelligence (Python / FastAPI) ---
INTELLIGENCE_PORT=8000
INTELLIGENCE_DB_URL=postgresql://rouaa:rouaa_dev@localhost:5432/rouaa

# --- Logging ---
LOG_LEVEL=debug
